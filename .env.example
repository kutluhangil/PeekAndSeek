# Google Maps API Configuration
# Get this from: https://console.cloud.google.com/apis/credentials
# Required APIs: Maps JavaScript API, Street View Static API, Geocoding API
VITE_GOOGLE_MAPS_API_KEY=your_api_key_here

# Vercel Deployment Notes:
# - PORT is automatically set by Vercel (default: 80)
# - NODE_ENV is automatically set to "production" on Vercel
# - Add VITE_GOOGLE_MAPS_API_KEY in Vercel Project Settings → Environment Variables
